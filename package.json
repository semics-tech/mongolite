{
  "name": "@semics-tech/mongolite",
  "version": "1.1.0",
  "description": "A MongoDB-like client using SQLite as a persistent store, written in TypeScript.",
  "main": "dist/cjs/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "require": "./dist/cjs/cloudflare.js"
    },
    "./better-sqlite3": {
      "types": "./dist/better-sqlite3.d.ts",
      "import": "./dist/better-sqlite3.js",
      "require": "./dist/cjs/better-sqlite3.js"
    }
  },
  "bin": {
    "mongolite-debug": "dist/bin/mongolite-debug.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && cp src/cjs-package-stub.json dist/cjs/package.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:parity": "node --import tsx --test tests/parity/*.parity.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --import tsx --test tests/*.test.ts",
    "test:coverage:check": "c8 --reporter=lcov --reporter=text --check-coverage --lines 80 --functions 80 --statements 80 --branches 70 node --import tsx --test tests/*.test.ts",
    "prepare": "npm run build",
    "prepublish": "npm run build",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "verify-build": "node --import tsx scripts/verify-build.js",
    "test-third-party": "node scripts/test-third-party-usage.js",
    "test:all": "npm run lint && npm run test && npm run verify-build && npm run test-third-party",
    "benchmark": "npx tsx scripts/benchmark.ts",
    "debug-queries": "npx tsx scripts/query-debugger.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semics-tech/mongolite.git"
  },
  "keywords": [
    "mongodb",
    "sqlite",
    "database",
    "client",
    "typescript",
    "nosql",
    "json",
    "embedded-database",
    "local-first",
    "cloudflare-workers",
    "durable-objects",
    "sql.js"
  ],
  "author": "Oliver Breeden <oliver@semics.co.uk>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/semics-tech/mongolite/issues"
  },
  "homepage": "https://github.com/semics-tech/mongolite#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "c8": "^12.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "expect": "^30.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.2.5",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@types/uuid": "^11.0.0",
    "bson": "^7.2.0",
    "uuid": "^14.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  }
}
